{
  "appId": "com.ravensplit.app",
  "appName": "RAVEN",
  "webDir": "dist",
  "plugins": { "PushNotifications": { "presentationOptions": ["badge", "sound", "banner", "list"] } },
  "ios": {
    "contentInset": "automatic",
    "backgroundColor": "#06060A"
  },
  "android": {
    "backgroundColor": "#06060A",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "allowNavigation": [
      "ravensplit.com",
      "www.ravensplit.com"
    ]
  }
}
